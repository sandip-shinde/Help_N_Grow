<h2>Admin Reports</h2>
@model Help_N_Grow.Entity.AdminReportsVM

@{
    ViewData["Title"] = "Admin View";
    Layout = "~/Views/Shared/_Super_AdminLayout.cshtml";
}

<h2>Admin View</h2>

<div class="row">
    <!-- Package Wise Amount -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4>Package Wise Report</h4>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Package Name</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Adminpackage_NameReports)
                        {
                            <tr>
                                <td>@item.package_Name</td>
                                <td>@item.Amount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Package + Level Wise Amount -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h4>Package & Level Report</h4>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Package Name</th>
                            <th>Level</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Adminpackage_Name_Level_Reports)
                        {
                            <tr>
                                <td>@item.package_Name</td>
                                <td>@item.Level</td>
                                <td>@item.Amount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<hr />

<div class="row">
    <!-- Package + Level + User Wise Amount -->
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h4>Package, Level & User Report</h4>
            </div>
            <div class="card-body">
                <table class="table table-bordered table-striped table-responsive">
                    <thead>
                        <tr>
                            <th>Package Name</th>
                            <th>Level</th>
                            <th>Full Name</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Adminpackage_Name_Level_Name_Reports)
                        {
                            <tr>
                                <td>@item.package_Name</td>
                                <td>@item.Level</td>
                                <td>@item.Full_Name</td>
                                <td>@item.Amount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>